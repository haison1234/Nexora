      "parameters": {
        "jsCode": "return [{json:{\"brandId\":\"techviet\",\"brandName\":\"TechViet Daily\",\"brandBrief\":\"AI và tự động hóa cho chủ doanh nghiệp nhỏ tại Việt Nam. Gần gũi, rõ ràng, thực tế. Không bịa số liệu.\",\"model\":\"SELECT_OPENROUTER_MODEL\",\"fromEmail\":\"SET_SENDER_EMAIL\",\"toEmail\":\"SET_APPROVER_EMAIL\",\"cloudName\":\"SET_CLOUDINARY_CLOUD_NAME\",\"uploadPreset\":\"SET_UNSIGNED_UPLOAD_PRESET\",\"graphVersion\":\"v23.0\",\"kromossUrl\":\"http://127.0.0.1:8787\",\"maxVersions\":3}}];"
      }
    },
    {
      "id": "b1a85018-2b83-4013-abbf-7f3f3f8b92a4",
      "name": "Read posts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "posts"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": []
        },
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "a36a797a-ab31-47a0-a8f6-2e5abcea800e",
      "name": "Select one post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuration').first().json; const now=Date.now(); const rows=$input.all().map(x=>x.json).filter(x=>x.postId && [\"DRAFT\"].includes(x.status) ).filter(x=>true).sort((a,b)=>String(a.scheduledAt).localeCompare(String(b.scheduledAt))); return rows.slice(0,1).map(x=>({json:{...x,cfg}}));"
      }
    },
    {
      "id": "a5ddac51-040d-445c-9102-33d501e84b18",
      "name": "Read version",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "post versions"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "versionId",
              "condition": "eq",
              "keyValue": "={{ $json.currentVersionId }}"
            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "a8aa6646-dcdb-40cb-8310-c0afd7e9f484",
      "name": "Image request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Select one post').first().json;const v=$input.first().json;if(!v.imagePrompt||v.postId!==c.postId)throw new Error('Valid image prompt is required'); if(c.cfg.cloudName.startsWith('SET_')||c.cfg.uploadPreset.startsWith('SET_'))throw new Error('Set Cloudinary cloudName and unsigned uploadPreset'); return [{json:{...c,version:v,assetId:v.versionId+'-image',seed:42,width:512,height:512,steps:10}}];"
      }
    },
    {
      "id": "5d6c823a-a1af-4789-aaec-a5138db0d577",
      "name": "Generate PNG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data",
              "fullResponse": true
            }
          }
        },
        "method": "POST",
        "url": "={{ $('Configuration').first().json.kromossUrl+'/generate' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({prompt:$json.version.imagePrompt,width:$json.width,height:$json.height,steps:$json.steps,seed:$json.seed,guidance_scale:3}) }}"
      }
    },
    {
      "id": "52a6bed5-9340-4d96-be91-ae5aec8c970a",
      "name": "Preserve image metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const item=$input.first();if(!item.binary?.data)throw new Error('Kromoss returned no image');const c=$('Image request').first().json;return [{json:{...c,localPath:item.json.headers?.['x-output-path']||''},binary:item.binary}];"
      }
    },
    {
      "id": "332c3109-88e8-4ed9-a58d-50415f4ec4d5",
      "name": "Upload image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "url": "={{ 'https://api.cloudinary.com/v1_1/'+$json.cfg.cloudName+'/image/upload' }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "upload_preset",
              "value": "={{ $json.cfg.uploadPreset }}"
            },
            {
              "name": "public_id",
              "value": "={{ $json.assetId }}"
            }
          ]
        }
      }
    },
    {
      "id": "e4badd73-e319-4bc7-8bbf-6b6ed195ccac",
      "name": "Validate stored image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Preserve image metadata').first().json;const a=$json;if(!a.secure_url||!a.public_id||!a.width||!a.height)throw new Error('Cloudinary returned incomplete image data');if(!/^https:\\/\\/res\\.cloudinary\\.com\\//.test(a.secure_url)||!a.secure_url.includes('/upload/'))throw new Error('Unexpected Cloudinary delivery URL');const publicUrl=a.secure_url.replace('/upload/','/upload/f_jpg,q_90/');return [{json:{assetId:c.assetId,storageProvider:'CLOUDINARY',storageKey:a.public_id,localPath:c.localPath,publicUrl,fileName:c.assetId+'.jpg',mimeType:'image/jpeg',width:a.width,height:a.height,sizeBytes:a.bytes,prompt:c.version.imagePrompt,modelName:'lodestones/Kromoss',seed:c.seed,status:'READY'}}];"
      }
    },
