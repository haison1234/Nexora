        "jsCode": "const c=$('Planner context').first().json; return $input.all().flatMap(({json:p})=>c.accounts.map(a=>{const date=p.planId.slice(-10);return {json:{postId:p.planId+'-'+a.accountId,planId:p.planId,accountId:a.accountId,platform:a.platform,contentType:'IMAGE',scheduledAt:date+(a.platform==='FACEBOOK'?'T11:00:00+07:00':'T19:00:00+07:00'),currentVersionId:'',approvedVersionId:'',status:'NEW'}};}));"
