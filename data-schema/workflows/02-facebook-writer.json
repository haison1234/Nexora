      "name": "Revision context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Plan context').first().json;const previous=$input.first().json;const versionNumber=Number(previous.versionNumber||0)+1;if(versionNumber>c.cfg.maxVersions) throw new Error('Revision limit reached');return [{json:{...c,previous,versionNumber}}];"
      }
    },
