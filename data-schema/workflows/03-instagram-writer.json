    {
      "id": "b0016526-f46a-4402-8836-cd609c3ae711",
      "name": "Validate draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "jsCode": "function parseJSON(value) { if (value && typeof value === 'object') return value; if(typeof value !== 'string') throw new Error('AI returned no JSON'); return JSON.parse(value.trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'')); }\nconst c=$('Writer prompt').first().json;const d=parseJSON($json.output);if(typeof d.caption!=='string'||!d.caption.trim()||typeof d.imagePrompt!=='string'||!d.imagePrompt.trim()) throw new Error('Caption and imagePrompt are required');const hashtags=Array.isArray(d.hashtags)?d.hashtags.join(' '):String(d.hashtags||'');if(c.platform==='INSTAGRAM'&&(d.caption+'\\n'+hashtags).length>2200)throw new Error('Instagram caption is too long');return [{json:{versionId:c.postId+'-v'+c.versionNumber,postId:c.postId,versionNumber:c.versionNumber,caption:d.caption.trim(),hashtags,imagePrompt:d.imagePrompt.trim(),source:'AI',modelName:c.cfg.model}}];"
      }
    },
