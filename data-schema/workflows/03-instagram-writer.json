        "filters": {
          "conditions": [
            {
              "keyName": "planId",
              "condition": "eq",
              "keyValue": "={{ $json.planId }}"
            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "567965de-f9aa-4c78-a59d-a69729a2ef1a",
      "name": "Plan context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "const plan=$input.first().json;if(!plan.planId) throw new Error('Content plan is missing');return [{json:{...$('Select one post').first().json,plan}}];"
      }
    },
