    {
      "id": "f8c8c275-a252-4c9d-8362-ab2ed25b30bb",
      "name": "Prevent repeated publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Publish context').first().json;const rows=$input.all().map(x=>x.json);if(rows.some(x=>x.publicationId&&['PUBLISHED','PUBLISHING','UNKNOWN','MANUAL_SENT'].includes(x.status)))return [];const previous=rows.find(x=>x.publicationId===c.publicationId);return [{json:{...c,attemptCount:Number(previous?.attemptCount||0)+1}}];"
      }
    },
