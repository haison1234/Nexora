    {
      "id": "ed655582-ebe5-4408-98a0-54aee5e66e46",
      "name": "Publish context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Media context').first().json;const account=$input.first().json;if(!account.externalAccountId||account.platform!==c.platform)throw new Error('Active platform account is missing');if(c.currentVersionId!==c.approvedVersionId)throw new Error('Approved version is stale');if(!Number.isFinite(Date.parse(c.scheduledAt))||Date.parse(c.scheduledAt)>Date.now())return [];return [{json:{...c,account,publicationId:c.postId+'-'+c.approvedVersionId,idempotencyKey:c.postId+'-'+c.approvedVersionId,caption:[c.version.caption,c.version.hashtags].filter(Boolean).join('\\n\\n')}}];"
      }
    },
