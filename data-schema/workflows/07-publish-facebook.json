    {
      "id": "624c33d5-00a9-48fd-b637-5569990dab54",
      "name": "Publish Facebook photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4080,
        300
      ],
      "parameters": {
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $('Configuration').first().json.graphVersion ? 'https://graph.facebook.com/'+$('Configuration').first().json.graphVersion+'/'+$('Publish context').first().json.account.externalAccountId+'/photos' : '' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Publish context').first().json.asset.publicUrl }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Publish context').first().json.caption }}"
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "e27f8de2-61ae-4aea-8841-9d18bc87d3d7",
      "name": "Interpret publish response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        300
      ],
      "parameters": {
        "jsCode": "const r=$json;const id=r.post_id||r.id;const success=typeof id==='string'&&id.length>0;return [{json:{status:success?'PUBLISHED':r.error?.code?'FAILED':'UNKNOWN',externalPostId:success?id:'',externalUrl:success?'https://www.facebook.com/'+id:'',publishedAt:success?new Date().toISOString():'',lastErrorCode:success?'':String(r.error?.code||'UNKNOWN_RESULT'),lastErrorMessage:success?'':JSON.stringify(r.error||r).slice(0,1000)}}];"
      }
    },
