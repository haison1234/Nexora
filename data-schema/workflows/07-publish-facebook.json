    {
      "id": "757ba887-2bf8-43ec-a1cb-dc2ae86da6f2",
      "name": "Select one post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuration').first().json; const now=Date.now(); const rows=$input.all().map(x=>x.json).filter(x=>x.postId && [\"APPROVED\"].includes(x.status) && x.platform==='FACEBOOK').filter(x=>Number.isFinite(Date.parse(x.scheduledAt)) && Date.parse(x.scheduledAt)<=now).sort((a,b)=>String(a.scheduledAt).localeCompare(String(b.scheduledAt))); return rows.slice(0,1).map(x=>({json:{...x,cfg}}));"
      }
    },
    {
      "id": "bc1c0504-6d56-498b-a8e2-afd01ccd5cb8",
      "name": "Read version",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "resource": "row",
