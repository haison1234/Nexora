      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.assetId).sort((a,b)=>Number(a.sortOrder)-Number(b.sortOrder)); if(!rows.length) throw new Error('No media is linked to this version'); return [{json:{...$('Version context').first().json,assetId:rows[0].assetId}}];"
      }
    },
