      "id": "90c1afcc-7630-4719-a3c3-4a3f8fd90596",
      "name": "Send approval form",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        3360,
        300
      ],
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "={{ $('Configuration').first().json.fromEmail }}",
        "toEmail": "={{ $('Configuration').first().json.toEmail }}",
        "subject": "={{ 'Duyệt bài '+$('Approval context').first().json.platform }}",
        "message": "={{ '<p>'+$('Approval context').first().json.platform+'</p><pre>'+$('Approval context').first().json.version.caption.replaceAll('&','&amp;').replaceAll('<','&lt;')+'\\n'+$('Approval context').first().json.version.hashtags+'</pre><p><img width=\"450\" src=\"'+$('Approval context').first().json.asset.publicUrl+'\"></p><p>APPROVE_AUTO: duyệt và đăng tự động khi đến lịch. APPROVE_MUSIC: chỉ dành cho Instagram; nhận ảnh và caption qua email để tự chọn nhạc và đăng. REJECT: từ chối.</p>' }}",
        "responseType": "customForm",
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify([{fieldLabel:'decision',fieldType:'dropdown',requiredField:true,fieldOptions:{values:($('Approval context').first().json.platform==='INSTAGRAM'?['APPROVE_AUTO','APPROVE_MUSIC','REJECT']:['APPROVE_AUTO','REJECT']).map(option=>({option}))}},{fieldLabel:'feedback',fieldType:'textarea'}]) }}",
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 24,
              "resumeUnit": "hours"
            }
          },
          "appendAttribution": false
        }
      },
      "webhookId": "b54bcb5f-7fd0-4585-bc5f-0aabc1668a14"
    },
    {
      "id": "99c71dbc-75c1-404f-90a5-053f704f1016",
      "name": "Validate human decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        300
      ],
      "parameters": {
        "jsCode": "const c=$('Approval context').first().json;const data=$json.data||{};const decision=data.decision;const expired=Date.now()>Date.parse(c.expiresAt);if(!expired&&!['APPROVE_AUTO','APPROVE_MUSIC','REJECT'].includes(decision))throw new Error('Missing or invalid approval choice');if(!expired&&decision==='APPROVE_MUSIC'&&c.platform!=='INSTAGRAM')throw new Error('Music choice is for Instagram only');return [{json:{...c,decision,approvalStatus:expired?'EXPIRED':decision==='REJECT'?'REJECTED':decision==='APPROVE_MUSIC'?'APPROVED_MANUAL':'APPROVED_AUTO',nextStatus:expired?'APPROVAL_EXPIRED':decision==='REJECT'?'REJECTED':decision==='APPROVE_MUSIC'?'MANUAL_READY':'APPROVED',feedback:String(data.feedback||''),decidedAt:new Date().toISOString()}}];"
      }
    },
